    "plan": {
        "title": "商业计划",
        "overview": {
            "title": "项目概述",
            "description": "介绍MOBA的分阶段商业计划和策略。",
            "detailedDescription": "MOBA项目通过系统性的4阶段方法实现海洋环境保护目标。每个阶段都建立在前一阶段成果的基础上，我们的最终目标是创建可持续的海洋保护生态系统。"
        },
        "phases": {
            "title": "执行流程",
            "phase1": {
                "title": "第一阶段：教育与资格获取",
                "description": "支持水肺/自由潜水国际资格证",
                "activities": [
                    "Open Water 或 Freediver 资格教学",
                    "Dive Against Debris® 专项培训（收集、安全、数据）",
                    "提供安全装备与收集工具",
                    "活动前安全简报必做"
                ]
            },
            "phase2": {
                "title": "第二阶段：水下清洁（潜水清洁）",
                "description": "年4次（季度1次）定期水下清洁",
                "activities": [
                    "2-10米沿岸水域，2-3人一组潜水",
                    "专业潜水领队带队",
                    "回收废渔网与塑料等海底垃圾",
                    "精确记录GPS、品目、重量、数量、照片",
                    "遵守伙伴潜水与检查清单"
                ]
            },
            "phase3": {
                "title": "第三阶段：数据上传与处理",
                "description": "上传国际数据库并进行合法处理",
                "activities": [
                    "上传至 Dive Against Debris® 平台",
                    "用于UNEP等政策制定",
                    "与地方政府/海洋机构合作合法处理",
                    "最大化回收可回收资源"
                ]
            },
            "phase4": {
                "title": "第四阶段：ESG报告",
                "description": "编制可验证的ESG成果报告",
                "activities": [
                    "环境：收集量、品目比重、碳减排",
                    "社会：参与人数、志愿时数、地方协作",
                    "治理：安全教育、保险、第三方验证",
                    "GRI 306、SDG 14、ISO 14001 联动",
                    "年度MOBA成果报告"
                ]
            },
            "phase5": {
                "title": "第五阶段：可视化项目",
                "description": "将收集成果转化为本地文化资产",
                "activities": [
                    "用收集的废弃物制作壁画、雕塑、渔船涂装",
                    "与本地艺术家、青少年、渔民共同创作",
                    "通过现场标识和二维码展示清洁数据",
                    "发布年度ESG艺术报告",
                    "作为永久本地文化资产保存"
                ]
            }
        },
